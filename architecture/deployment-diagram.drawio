        <mxCell id="eval-cli" value="&lt;b&gt;Make / Docker Compose&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;evals • evals-lab • evals-run&lt;br&gt;evals-ragas • evals-gate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=13;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="75" y="340" width="260" height="105" as="geometry"/></mxCell>
        <mxCell id="eval-files" value="&lt;b&gt;Bind-mounted repository&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;versioned datasets • outcomes • reports&lt;br&gt;baselines • release snapshots&lt;/font&gt;" style="shape=folder;tabWidth=55;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="65" y="525" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="eval-trust" value="&lt;b&gt;Deliberate local-only trust model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Eval API binds to 127.0.0.1:3005 and calls Know Hub directly using synthetic X-User-* identities. This is an engineering tool, not a production API.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f3e8ff;strokeColor=#8b5cf6;strokeWidth=2;fontColor=#4c1d95;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="290" height="165" as="geometry"/></mxCell>

        <mxCell id="eval-docker" value="DOCKER ENGINE — lean brainwave NETWORK" style="swimlane;horizontal=0;startSize=32;html=1;rounded=1;fillColor=#faf5ff;strokeColor=#8b5cf6;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#4c1d95;fontStyle=1;fontSize=13;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="420" y="125" width="1500" height="900" as="geometry"/></mxCell>
        <mxCell id="eval-app-zone" value="EVALUATION WORKLOADS" style="swimlane;horizontal=0;startSize=26;html=1;rounded=1;fillColor=#faf5ff;strokeColor=#8b5cf6;fontColor=#4c1d95;fontStyle=1;fontSize=11;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="455" y="175" width="1425" height="225" as="geometry"/></mxCell>
        <mxCell id="eval-api" value="&lt;b&gt;Eval API :3005&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;long-running • localhost-published&lt;br&gt;datasets • probes • experiments • judges • gates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#8b5cf6;strokeWidth=3;fontSize=14;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="495" y="225" width="350" height="115" as="geometry"/></mxCell>
        <mxCell id="eval-runner" value="&lt;b&gt;eval-runner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one-shot agent-hub code&lt;br&gt;retrieval/generation suites • in-process CRAG&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="945" y="225" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="ragas" value="&lt;b&gt;ragas-runner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one-shot stage 2&lt;br&gt;isolated dependency environment • JSON handoff&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1385" y="225" width="330" height="115" as="geometry"/></mxCell>

        <mxCell id="eval-know-zone" value="KNOWLEDGE SERVICE — indexing owner in this profile" style="swimlane;horizontal=0;startSize=26;html=1;rounded=1;fillColor=#fffbeb;strokeColor=#d79b00;fontColor=#92400e;fontStyle=1;fontSize=11;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="455" y="425" width="1425" height="180" as="geometry"/></mxCell>
        <mxCell id="eval-know" value="&lt;b&gt;Know Hub :3002 / gRPC :50052&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;semantic worker ON • gRPC ON • query threshold 0.0&lt;br&gt;OTel + Langfuse OFF because those containers are absent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;fontSize=14;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="550" y="475" width="650" height="95" as="geometry"/></mxCell>
        <mxCell id="no-agent" value="&lt;b&gt;Agent Hub service intentionally absent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Know Hub's local worker is the single Kafka indexing consumer, avoiding duplicate chunk replacement.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontColor=#7f1d1d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1330" y="465" width="450" height="110" as="geometry"/></mxCell>

        <mxCell id="eval-data-zone" value="MINIMUM PLATFORM DEPENDENCIES" style="swimlane;horizontal=0;startSize=26;html=1;rounded=1;fillColor=#f0fdf4;strokeColor=#82b366;fontColor=#166534;fontStyle=1;fontSize=11;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="455" y="630" width="1425" height="245" as="geometry"/></mxCell>
        <mxCell id="eval-pg" value="&lt;b&gt;PostgreSQL + pgvector&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Know Hub document metadata&lt;br&gt;vector chunks&lt;br&gt;&lt;i&gt;Eval run/report state is file-backed or in memory&lt;/i&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="475" y="680" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="eval-mongo" value="&lt;b&gt;MongoDB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;readiness dependency&lt;br&gt;no seeded eval payloads&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="785" y="690" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="eval-minio" value="&lt;b&gt;MinIO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;eval Markdown payloads&lt;br&gt;binary objects&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1035" y="690" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="eval-kafka" value="&lt;b&gt;Kafka&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;document events&lt;br&gt;single indexing consumer&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1285" y="690" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="eval-ollama" value="&lt;b&gt;Ollama :11434&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;embed • generate • grade • judge&lt;br&gt;local model volume&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1555" y="690" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="not-started" value="&lt;b&gt;Not started:&lt;/b&gt; Kong • Keycloak • Auth Hub • User Hub • Audit Hub • Agent Hub service • observability overlay" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#374151;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="915" width="980" height="60" as="geometry"/></mxCell>

        <mxCell id="e-ui-api" value="HTTP /api/eval&lt;br&gt;localhost • no JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8b5cf6;strokeWidth=2;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="eval-ui" target="eval-api"><mxGeometry relative="1" as="geometry"/></mxCell>
