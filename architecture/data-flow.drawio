        <mxCell id="v-ci" value="&lt;b&gt;CI release gate&lt;/b&gt;&lt;br&gt;Exported policy / baseline / candidate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1480" y="730" width="230" height="115" as="geometry"/></mxCell>

        <mxCell id="v-excluded" value="&lt;b&gt;Deliberately absent&lt;/b&gt;&lt;br&gt;Kong • Keycloak • Auth Hub • User Hub • Audit Hub&lt;br&gt;normal Agent Hub service • observability overlay" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7f1d1d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="560" width="250" height="145" as="geometry"/></mxCell>

        <mxCell id="v-e1" value="1  Evaluation pages" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8b5cf6;strokeWidth=2;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v-user" target="v-vite"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="v-e2" value="2  Direct local HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8b5cf6;strokeWidth=2;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v-vite" target="v-api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="v-e3" value="3  Versioned artifacts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8b5cf6;strokeWidth=2;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v-api" target="v-store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="v-e4" value="4  Upload / status / hybrid + vector HTTP&lt;br&gt;chunk vector gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8b5cf6;strokeWidth=2;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v-api" target="v-know"><mxGeometry relative="1" as="geometry"/></mxCell>
