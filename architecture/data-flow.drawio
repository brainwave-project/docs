<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-10-12T12:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="df-auth" name="01 - Authentication and Request">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="a-title" value="Data Flow 01 — Login and an Authenticated Command" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=27;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="45" as="geometry"/></mxCell>
        <mxCell id="a-sub" value="Kong is the intended identity boundary; services trust its headers, while route-level authorization coverage varies." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1150" height="30" as="geometry"/></mxCell>

        <mxCell id="a-browser" value="&lt;b&gt;1. Browser / React UI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Credentials, bearer token,&lt;br&gt;API command&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="220" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="a-kong" value="&lt;b&gt;2. Kong&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Public auth routes&lt;br&gt;JWT signature + expiry&lt;br&gt;identity / role / correlation headers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="390" y="205" width="250" height="145" as="geometry"/></mxCell>
        <mxCell id="a-auth" value="&lt;b&gt;3. Auth Hub&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Login / refresh / password flow&lt;br&gt;Auth event producer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="745" y="145" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="a-kc" value="&lt;b&gt;4. Keycloak&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Verify credentials&lt;br&gt;Issue access / refresh tokens&lt;br&gt;Realm roles in JWT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1100" y="145" width="255" height="130" as="geometry"/></mxCell>
        <mxCell id="a-svc" value="&lt;b&gt;6. Target domain service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;User / Know / Agent / Audit&lt;br&gt;Trust X-User-* headers&lt;br&gt;Authorization varies by route/service&lt;br&gt;Execute owned operation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="735" y="490" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="a-store" value="&lt;b&gt;7. Service-owned store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Commit business state&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1130" y="510" width="240" height="115" as="geometry"/></mxCell>
        <mxCell id="a-kafka" value="&lt;b&gt;8. Kafka&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Domain topic&lt;br&gt;best-effort publish&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="770" y="750" width="220" height="115" as="geometry"/></mxCell>
        <mxCell id="a-audit" value="&lt;b&gt;9. Audit Hub&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Idempotent consume&lt;br&gt;append audit event&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1130" y="750" width="240" height="115" as="geometry"/></mxCell>
        <mxCell id="a-auditdb" value="audit.audit_events" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1480" y="765" width="210" height="90" as="geometry"/></mxCell>

        <mxCell id="a-e1" value="1  POST /api/auth/login" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a-browser" target="a-kong"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e2" value="2  Public route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a-kong" target="a-auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e3" value="3  Token endpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a-auth" target="a-kc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e4" value="4a  Token set" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a-kc" target="a-auth"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1225" y="105"/><mxPoint x="870" y="105"/></Array></mxGeometry></mxCell>
        <mxCell id="a-e4b" value="4b  Auth response" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a-auth" target="a-kong"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="105"/><mxPoint x="515" y="105"/></Array></mxGeometry></mxCell>
        <mxCell id="a-e4c" value="4c  Login response + token set" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a-kong" target="a-browser"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="515" y="105"/><mxPoint x="185" y="105"/></Array></mxGeometry></mxCell>
        <mxCell id="a-e5" value="5  API request + bearer JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a-browser" target="a-kong"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="345" y="405"/></Array></mxGeometry></mxCell>
        <mxCell id="a-e6" value="6  Validated identity headers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a-kong" target="a-svc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e7" value="7  Read / write transaction" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#15803d;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a-svc" target="a-store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e8" value="8  Event after action" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d97706;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a-svc" target="a-kafka"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e9" value="9  Consume all topics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d97706;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a-kafka" target="a-audit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e10" value="Append; event_id unique" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#15803d;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a-audit" target="a-auditdb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-key-note" value="Kong verifies JWTs from the configured Keycloak issuer credential locally; it does not call Keycloak on every request." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1430" y="135" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="a-risk" value="&lt;b&gt;Boundary requirement&lt;/b&gt;&lt;br&gt;Direct service access can bypass Kong and spoof trusted headers. User Hub lacks route-level role enforcement; Audit all-activity lacks an ADMIN check. Publish only the gateway and enforce authorization in every service." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7f1d1d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1410" y="405" width="330" height="155" as="geometry"/></mxCell>
        <mxCell id="a-logout-note" value="&lt;b&gt;Current logout behavior&lt;/b&gt;&lt;br&gt;The UI omits the ID-token hint, ignores Auth Hub's returned Keycloak end-session URL, and clears only local state. The Keycloak session remains." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#78350f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1410" y="590" width="330" height="130" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="df-ingestion" name="02 - Upload and Indexing">
    <mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="i-title" value="Data Flow 02 — Document Upload and Asynchronous Indexing" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=27;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="45" as="geometry"/></mxCell>
        <mxCell id="i-sub" value="A document becomes AVAILABLE before it becomes searchable. Exactly one indexing pipeline must own DOCUMENT_UPLOADED." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1250" height="30" as="geometry"/></mxCell>

        <mxCell id="i-ui" value="&lt;b&gt;1. UI + Kong&lt;/b&gt;&lt;br&gt;POST /api/documents&lt;br&gt;file / structured payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="i-api" value="&lt;b&gt;2. Know Hub upload API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Permission + idempotency&lt;br&gt;upload saga + lifecycle&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="370" y="170" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="i-pgmeta" value="&lt;b&gt;3. PostgreSQL doc schema&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;idempotency key&lt;br&gt;document + lifecycle&lt;br&gt;RECEIVED → PERSISTING → AVAILABLE&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="135" width="280" height="170" as="geometry"/></mxCell>
        <mxCell id="i-mongo" value="&lt;b&gt;4a. MongoDB&lt;/b&gt;&lt;br&gt;Structured payload / note" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=16;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1090" y="120" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="i-minio" value="&lt;b&gt;4b. MinIO hot bucket&lt;/b&gt;&lt;br&gt;Binary object" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=16;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1090" y="250" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="i-http" value="&lt;b&gt;5a. HTTP 201&lt;/b&gt;&lt;br&gt;Document AVAILABLE&lt;br&gt;embedding PENDING&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;does not await Kafka delivery&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1410" y="170" width="240" height="130" as="geometry"/></mxCell>

        <mxCell id="i-kafka" value="&lt;b&gt;5b. Kafka&lt;/b&gt;&lt;br&gt;brainwave.document.events&lt;br&gt;DOCUMENT_UPLOADED&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;fire-and-forget publish&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="440" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="i-audit" value="&lt;b&gt;7. Audit Hub&lt;/b&gt;&lt;br&gt;Append upload event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="220" height="100" as="geometry"/></mxCell>

        <mxCell id="i-choice" value="&lt;b&gt;8. INDEXER OWNERSHIP&lt;/b&gt;&lt;br&gt;Mutually exclusive configuration invariant" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="770" y="430" width="260" height="160" as="geometry"/></mxCell>
        <mxCell id="i-agent" value="&lt;b&gt;8A. Agent Hub ingestion crew&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;GetPayload gRPC → extract → classify&lt;br&gt;adaptive chunk → Ollama embed&lt;br&gt;PersistChunks + UpdateMetadata gRPC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1110" y="405" width="330" height="180" as="geometry"/></mxCell>
        <mxCell id="i-local" value="&lt;b&gt;8B. Know Hub semantic worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Local payload read → fixed 512/64 chunks&lt;br&gt;Ollama embed → local vector write&lt;br&gt;INDEXED / SKIPPED / FAILED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1110" y="680" width="330" height="165" as="geometry"/></mxCell>
        <mxCell id="i-ollama" value="&lt;b&gt;Ollama&lt;/b&gt;&lt;br&gt;classification / embedding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1540" y="495" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="i-sem" value="&lt;b&gt;9. Know Hub authoritative write&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;sem.document_chunks&lt;br&gt;doc embedding_status&lt;br&gt;classification from Agent pipeline only&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1500" y="710" width="310" height="150" as="geometry"/></mxCell>
        <mxCell id="i-state" value="&lt;b&gt;Searchability state&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Local: PENDING → INDEXING → INDEXED/SKIPPED/FAILED&lt;br&gt;Agent embedder writes INDEXED or FAILED&lt;br&gt;Agent skip / pre-embed failure can remain PENDING&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1470" y="900" width="370" height="120" as="geometry"/></mxCell>
        <mxCell id="i-risk" value="&lt;b&gt;Do not enable both consumers&lt;/b&gt;&lt;br&gt;They have distinct Kafka groups, so each receives every upload and can replace the other's chunks. Manual reindex always invokes the local fixed-chunk implementation." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7f1d1d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="795" width="330" height="145" as="geometry"/></mxCell>

        <mxCell id="i-e1" value="1  JWT + upload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i-ui" target="i-api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e2" value="2–3  Metadata + lifecycle transactions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#15803d;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i-api" target="i-pgmeta"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e3" value="4a  structured" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#15803d;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i-api" target="i-mongo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e4" value="4b  binary" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#15803d;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i-api" target="i-minio"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e5" value="5a  response after persistence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i-api" target="i-http"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e6" value="5b  publish started, not awaited&lt;br&gt;completion order is not guaranteed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d97706;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i-api" target="i-kafka"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e7" value="7  audit consumer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d97706;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i-kafka" target="i-audit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e8" value="8  upload event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d97706;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i-kafka" target="i-choice"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e9" value="full dev: Agent crew" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7c3aed;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i-choice" target="i-agent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e10" value="production / eval: Know local worker&lt;br&gt;staging intended, but app overlay is boot-blocked" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d97706;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i-choice" target="i-local"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e11" value="embed / classify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7c3aed;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i-agent" target="i-ollama"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e12" value="embed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7c3aed;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i-local" target="i-ollama"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e13" value="gRPC chunks + classification&lt;br&gt;+ INDEXED/FAILED from embedder path" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i-agent" target="i-sem"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e14" value="local chunks + status&lt;br&gt;sets INDEXING first" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#15803d;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i-local" target="i-sem"><mxGeometry relative="1" as="geometry"/></mxCell>
