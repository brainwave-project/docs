        <mxCell id="v-title" value="Data Flow 04 — Lean Local Evaluation Lab" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=27;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="45" as="geometry"/></mxCell>
        <mxCell id="v-sub" value="Development-only exception: localhost Eval API, file-backed experiment state, direct Know Hub/Ollama calls, no normal Agent Hub service." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1400" height="30" as="geometry"/></mxCell>

        <mxCell id="v-boundary" value="LEAN EVAL PROFILE" style="swimlane;horizontal=0;startSize=30;html=1;rounded=1;fillColor=#faf5ff;strokeColor=#8b5cf6;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#6b21a8;fontStyle=1;fontSize=12;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="330" y="125" width="1370" height="760" as="geometry"/></mxCell>
        <mxCell id="v-user" value="&lt;b&gt;Quality engineer&lt;/b&gt;&lt;br&gt;Evaluation UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="55" y="265" width="220" height="95" as="geometry"/></mxCell>
        <mxCell id="v-vite" value="&lt;b&gt;Vite dev proxy&lt;/b&gt;&lt;br&gt;/api/eval → 127.0.0.1:3005&lt;br&gt;no JWT attached" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#8b5cf6;strokeWidth=2;dashed=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="235" width="245" height="115" as="geometry"/></mxCell>
        <mxCell id="v-api" value="&lt;b&gt;Standalone Eval API :3005&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Dataset/version lifecycle&lt;br&gt;index + retrieval jobs&lt;br&gt;generation • judges • stats • release gates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#8b5cf6;strokeWidth=3;dashed=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="730" y="205" width="300" height="170" as="geometry"/></mxCell>
        <mxCell id="v-store" value="&lt;b&gt;Versioned LabStore&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;JSON / JSONL files&lt;br&gt;corpus • golden labels • indexes&lt;br&gt;runs • experiments • judges • gates&lt;/font&gt;" style="shape=folder;tabWidth=60;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#f3e8ff;strokeColor=#8b5cf6;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1170" y="185" width="300" height="170" as="geometry"/></mxCell>

        <mxCell id="v-know" value="&lt;b&gt;Know Hub :3002 / :50052&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Direct HTTP upload/status/hybrid + vector search&lt;br&gt;gRPC chunk vector search&lt;br&gt;synthetic owner + EDITOR headers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="690" y="500" width="340" height="155" as="geometry"/></mxCell>
        <mxCell id="v-worker" value="&lt;b&gt;Know semantic worker ON&lt;/b&gt;&lt;br&gt;Consumes DOCUMENT_UPLOADED&lt;br&gt;fixed chunk + embed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1165" y="500" width="260" height="115" as="geometry"/></mxCell>
        <mxCell id="v-kafka" value="Kafka&lt;br&gt;document.events" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1500" y="500" width="160" height="110" as="geometry"/></mxCell>
        <mxCell id="v-data" value="&lt;b&gt;Active evaluation corpus stores&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PostgreSQL/pgvector metadata + chunks&lt;br&gt;MinIO Markdown payloads&lt;br&gt;MongoDB runs for Know Hub readiness, not seeded payloads&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="660" y="715" width="400" height="145" as="geometry"/></mxCell>
