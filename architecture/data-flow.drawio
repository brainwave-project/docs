        <mxCell id="r-result" value="&lt;b&gt;Results to UI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Search documents&lt;br&gt;or SSE tokens + citations + decisions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1605" y="300" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="r-note" value="&lt;b&gt;Isolation invariant&lt;/b&gt;&lt;br&gt;The SQL owner/admin predicate is the document isolation boundary. Prompt instructions are not an authorization mechanism." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7f1d1d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1565" y="760" width="285" height="125" as="geometry"/></mxCell>

