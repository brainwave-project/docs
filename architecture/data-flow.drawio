  <diagram id="df-retrieval" name="03 - Retrieval and Chat">
    <mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="r-title" value="Data Flow 03 — Semantic Search, Know Hub Chat, and Corrective Agent Chat" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=27;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="45" as="geometry"/></mxCell>
        <mxCell id="r-sub" value="Three read/generation paths share the same owner-filtered vector corpus but differ in orchestration and persistence." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1250" height="30" as="geometry"/></mxCell>

        <mxCell id="r-ui" value="&lt;b&gt;UI + Kong&lt;/b&gt;&lt;br&gt;JWT → trusted identity headers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="55" y="420" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="r-search" value="&lt;b&gt;A. Semantic Search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;GET /api/semantic/search&lt;br&gt;document-level results&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="390" y="145" width="260" height="115" as="geometry"/></mxCell>
        <mxCell id="r-kchat" value="&lt;b&gt;B. Know Hub Chat&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;POST /api/chat/.../messages&lt;br&gt;direct conversational RAG&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="390" y="420" width="260" height="125" as="geometry"/></mxCell>
        <mxCell id="r-agent" value="&lt;b&gt;C. Agent Hub CRAG&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;POST /api/agent/chat&lt;br&gt;corrective graph + SSE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="390" y="720" width="260" height="125" as="geometry"/></mxCell>

        <mxCell id="r-know" value="&lt;b&gt;Know Hub retrieval service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Embed query • LRU vector cache&lt;br&gt;owner/admin predicate&lt;br&gt;HTTP hybrid/vector = documents • gRPC vector = chunks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;fontSize=15;" vertex="1" parent="1"><mxGeometry x="790" y="300" width="330" height="180" as="geometry"/></mxCell>
        <mxCell id="r-pgsem" value="&lt;b&gt;PostgreSQL sem + doc&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;pgvector cosine ANN&lt;br&gt;English FTS + RRF for HTTP hybrid&lt;br&gt;state / owner joins&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1300" y="260" width="290" height="160" as="geometry"/></mxCell>
        <mxCell id="r-ollama" value="&lt;b&gt;Ollama&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;query embedding&lt;br&gt;condense • grade • rewrite&lt;br&gt;generate • grounding check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1300" y="515" width="290" height="155" as="geometry"/></mxCell>

        <mxCell id="r-chatstore" value="&lt;b&gt;PostgreSQL chat&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;sessions • user/assistant turns&lt;br&gt;citation IDs + scores&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="790" y="560" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="r-agentstore" value="&lt;b&gt;PostgreSQL agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;runs • redacted steps • governance&lt;br&gt;full LangGraph checkpoints&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="790" y="790" width="300" height="135" as="geometry"/></mxCell>
